<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One band of the board. Android 12+ gets each band's exact height;
         older versions scale it to the widget's width. -->
    <style name="MatchSlice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">fitXY</item>
    </style>
    <!-- One tap zone of the header; its exact size is set from the drawing. -->
    <style name="HeadSlice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">fitXY</item>
    </style>
</resources>
