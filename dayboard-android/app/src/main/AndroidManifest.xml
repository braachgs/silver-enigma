<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reads the calendars already synced to this phone: no Google sign-in. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- The board adds, edits and deletes events (they sync to Google as usual). -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- The board is the web app, loaded from GitHub Pages and kept offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wakes the widget exactly when a remark changes (BOARDING, FINAL CALL, NOW). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DayBoard">

        <!-- Day Board: the board, reading every account on this phone. -->
        <activity
            android:name=".BoardActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget settings (from the board's Settings), and where the browser
             version's "Send to Android app" link lands. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/widget_settings_name"
            android:launchMode="singleTop">
            <!-- dayboard://lines?d=…: Day Board's line setup, from the web app's Settings. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dayboard" android:host="lines" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BoardWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/board_widget_info" />
        </receiver>

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- System events that change what the board should show. Exported so
             the system can deliver them; these broadcasts are protected, so no
             other app can send them. -->
        <receiver
            android:name=".SystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CalendarChangeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
